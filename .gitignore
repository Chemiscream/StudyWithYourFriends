# 构建产物
target/
build/
out/

# 前端（Vue/Vite）
frontend/node_modules/
# 前端外置静态目录（运行时由 sync-static.js 生成，内容与 jar 内副本一致）
static-frontend/

# 日志
*.log
*.out
app.err.log
app.out.log

# 数据库文件（SQLite/MySQL 本地数据/导出），库本体在 C:\Files\dev\mysql-data，不进仓库
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sql.bak
data/
mysql-data/

# 本地配置（含密码等环境差异，只提交 application.yml 模板）
application-local.yml
application-local.properties
admin-credentials.properties

# IDE / 系统
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.DS_Store
Thumbs.db
