*.log
*.out
app.err.log
app.out.log

# 数据库文件（SQLite/MySQL 本地数据/导出），库本体在 C:\Files\dev\mysql-data，不进仓库
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sql.bak
data/
mysql-data/

# 本地配置（含密码等环境差异，只提交 application.yml 模板）
application-local.yml
application-local.properties
admin-credentials.properties

# 本地私密待办记录（含未发布计划与个人信息，不提交）
BACKLOG.md

# 设计素材工作区（定稿/姿势原图、抠图脚本等，不提交）
design-drafts/

